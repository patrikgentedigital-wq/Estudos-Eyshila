# Portal de Estudos Eyshila Caxias - Environment Variables

# Gemini / OpenRouter API Key (Server-side only)
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Supabase Authentication & Database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase access used to keep exam answer keys out of the browser.
# Never prefix the secret key with VITE_ and never commit a real value.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Application URL
APP_URL=
