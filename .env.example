# Portal de Estudos Eyshila Caxias - Environment Variables

# Gemini / OpenRouter API Key (Server-side only).
# OpenRouter é usado quando OPENROUTER_API_KEY está definida; caso contrário,
# a chave GEMINI_API_KEY ativa chamadas nativas à API Gemini.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENROUTER_MODEL=
GEMINI_MODEL=

# Supabase Authentication & Database
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-side Supabase access used to keep exam answer keys out of the browser.
# Never prefix the secret key with VITE_ and never commit a real value.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Application URL
APP_URL=
